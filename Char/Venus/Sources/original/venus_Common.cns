[Statedef 5210]; Air get-hit (fall recovery in air)*************************
type    = A
movetype= I
physics = N
anim = 5210
ctrl = 0

[State 5210, PosFreeze]
type = PosFreeze
trigger1 = Time < 4

[State 5210, Turn] ;Turn if not facing opponent
type = Turn
trigger1 = Time = 0
trigger1 = p2dist X < Const720p(-80)

[State 5210, VelMul1.0 behavior 1]
type = VelMul
trigger1 = Time = 4
x = Const(velocity.air.gethit.airrecover.mul.x)
y = Const(velocity.air.gethit.airrecover.mul.y)

[State 5210, VelAdd1.0 behavior 2]
type = VelAdd
trigger1 = Time = 4
x = Const(velocity.air.gethit.airrecover.add.x)
y = Const(velocity.air.gethit.airrecover.add.y)

[State 5210, null2002.04.14 behavior 1]
type = null;VelMul
trigger1 = Time = 4
x = .8
y = .8

[State 5210, null2002.04.14 behavior 2]
type = null;VelAdd
trigger1 = Time = 4
x = 0
y = -4.5

[State 5210, null2002.04.14 behavior 3]
type = null;VelMul
trigger1 = Time = 4
trigger1 = Vel Y > 0
y = .5

[State 5210, null2002.04.14 behavior 4]
type = null;VelAdd
trigger1 = Time = 4
trigger1 = Vel Y > -3
y = -2

[State 5210, null2002.04.14 behavior 5]
type = null;VelAdd
trigger1 = Time = 4
trigger1 = Vel Y > -2
y = -1

[State 5210, VelAdd] ;Go up
type = VelAdd
trigger1 = Time = 4
trigger1 = Command = "holdup"
y = Const(velocity.air.gethit.airrecover.up)

[State 5210, VelAdd] ;Go down
type = VelAdd
trigger1 = Time = 4
trigger1 = Command = "holddown"
y = Const(velocity.air.gethit.airrecover.down)

[State 5210, VelAdd] ;Go fwd
type = VelAdd
trigger1 = Time = 4
trigger1 = Command = "holdfwd"
x = Const(velocity.air.gethit.airrecover.fwd)

[State 5210, VelAdd] ;Go back
type = VelAdd
trigger1 = Time = 4
trigger1 = Command = "holdback"
x = Const(velocity.air.gethit.airrecover.back)

[State 5210, NotHitBy]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 15

[State 5210, CtrlSet]
type = CtrlSet
trigger1 = Time = 20
value = 1

[State 5210, VelAdd]
type = VelAdd
trigger1 = Time >= 4
y = Const(movement.air.gethit.airrecover.yaccel)

[State 5210, ChangeState] ;Land on ground
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;Jump land
ctrl = 1

[Statedef 5500]; Continue screen animation**********************************
type = S
ctrl = 0
anim = 5300
velset = 0,0

[State 5500, ChangeAnim] ;Use continue animation if available
type = ChangeAnim
trigger1 = time = 0
trigger1 = SelfAnimExist(5500)
value = 5500

[Statedef 5900]; Initialize (at the start of the round)*********************
type = S

[State 5900, VarRangeSet] ;Clear all int variables
type = VarRangeSet
trigger1 = RoundsExisted = 0
value = 0
first = 0
last = 48

[State 5900, VarRangeSet] ;Clear all float variables
type = VarRangeSet
trigger1 = RoundsExisted = 0
fvalue = 0

[State 5900, ChangeState] ;Intro for round 1
type = ChangeState
trigger1 = RoundNo = 1
value = 190

[State 5900, ChangeState] ;All other rounds
type = ChangeState
trigger1 = 1
value = 0
