trigger1 = 1
y = GetHitVar(yaccel)

[State 5200, SelfState]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= Const(movement.air.gethit.groundrecover.groundlevel)
value = 5201

[Statedef 5201]; Air get-hit (fall recovery on ground)**********************
type    = A
movetype= H
physics = A
anim = 5200

[State 5201, Turn] ;Turn if not facing opponent
