[Statedef 0]; Stand*********************************************************
type = S
physics = S
sprpriority = 0

[State 0, StopSnd]
type = StopSnd
trigger1 = PrevStateNo = [191,199]
channel = 0

[State 0, ChangeAnim];
type = ChangeAnim
triggerall = life > lifemax/4
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 0

[State 0, ChangeAnim];
type = ChangeAnim
triggerall = life <= lifemax/4
trigger1 = Anim != 5300 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 5300

[State 0, PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 0, VelSet]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, StopLowVelocity]
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, CtrlSet];
type = CtrlSet
triggerall = AILevel
triggerall = prevstateno = 20
triggerall = roundstate = 2
trigger1 = Time = 0
value = 1

[State 0, DeadDetect]
type = ChangeState
trigger1 = !alive
value = 5050

[Statedef 10]; Stand to Crouch**********************************************
type    = C
physics = C
anim = 10

[State 10, VelMul]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, CtrlSet]
type = CtrlSet
trigger1 = !AIlevel
;
trigger2 = AIlevel
trigger2 = P2StateType != A
trigger2 = P2StateType != L
trigger2 = var(16)>40
;
trigger3 = AIlevel
trigger3 = P2StateType = A
trigger3 = P2MoveType = A 
trigger3 = var(16) < 25
trigger3 = P2BodyDist Y > -80
;
trigger4 = AIlevel
trigger4 = P2StateType != L
trigger4 = P2BodyDist X < 120
;
trigger5 = P2StateNo = 5120
trigger5 = var(16) < 35
;
trigger6 = RoundState != 2
value = 1

[State 10, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

[Statedef 11]; Crouching****************************************************
type    = C
physics = C
anim = 11
sprpriority = 0
ctrl = 0

[State 11, CtrlSet]
type = CtrlSet
trigger1 = !AIlevel
;
trigger2 = AIlevel
trigger2 = P2StateType != A
trigger2 = P2StateType != L
trigger2 = var(16)>40
;
trigger3 = AIlevel
trigger3 = P2StateType = A
trigger3 = P2MoveType = A 
trigger3 = var(16) < 25
trigger3 = P2BodyDist Y > -80
;
trigger4 = AIlevel
trigger4 = P2StateType != L
trigger4 = P2BodyDist X < 120
;
trigger5 = P2StateNo = 5120
trigger5 = var(16) < 35
;
trigger6 = RoundState != 2
value = 1

[State 11, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, StopLowVelocity]
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[Statedef 12]; Crouch to Stand**********************************************
type = S
physics = S
anim = 12
ctrl = 0

[State 12, CtrlSet];
type = CtrlSet
trigger1 = P2MoveType=A && command="holdback" && InGuardDist
value = 1

[State 12, CtrlSet];
type = CtrlSet
trigger1 = Time = 1
value = 1

[State 12, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[Statedef 20]; Walk*********************************************************
type    = S
physics = S
sprpriority = 0

[State 20, VelSet]
type = VelSet
triggerall = !AILevel
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, VelSet]
type = VelSet
triggerall = !AILevel
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, VelSet];
type = VelSet
triggerall = AILevel
trigger1 = Enemy,MoveType != A	
;trigger1 = Helper(9999),var(25) = 1
x = const(velocity.walk.fwd.x)

[State 20, VelSet];
type = VelSet
triggerall = AILevel
trigger1 = Enemy,MoveType = A && Enemy,HitDefAttr = SCA,AA
;trigger1 = Helper(9999),var(25) = 0
x = const(velocity.walk.back.x)

[State 20, ChangeAnim]
type = ChangeAnim
triggerall = Vel X > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, ChangeAnim]
type = ChangeAnim
triggerall = Vel X < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, CtrlSet]
type = CtrlSet
triggerall = AILevel
trigger1 = Time = 0
value = 0

[State 20, CtrlSet]
type = CtrlSet
triggerall = AILevel
trigger1 = Time > 30
;
trigger2 = P2BodyDist X < 160
;
trigger3 = P2MoveType = H
trigger3 = P2StateType = A
trigger3 = P2BodyDist X < 320
;
trigger4 = EnemyNear, MoveType = A
;
trigger5 = EnemyNear,HitDefAttr = SCA,AP
value = 1

[State 20, ChangeState];
type = ChangeState
triggerall = AILevel
trigger1 = P2BodyDist X < 80
trigger2 = Time > 30
trigger3 = Vel X = 0
value = 0
ctrl = 1

[Statedef 40]; Jump Start***************************************************
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, VarSet]
type = VarSet
triggerall = !AILevel
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, VarSet];
type = VarSet
triggerall = AILevel
trigger1 = P2BodyDist x >= 160
trigger2= P2stateno = 5120
trigger3= P2movetype = H && P2statetype = A
sysvar(1) = 1

[State 40, VarSet];
type = VarSet
triggerall = AILevel
triggerall = P2movetype != H
trigger1 = P2BodyDist X < 60
sysvar(1) = -1

[State 40, VarSet]
type = VarSet
triggerall = !AILevel
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, VelSet]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1) = 0, const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, VelSet]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, ChangeState];
type = ChangeState
trigger1 = AILevel && var(30) = 0
value = 0
ctrl = 1

[State 40, PlaySnd];
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,1
channel = 1

[State 40, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

[Statedef 45]; AirJump Start************************************************
type    = A
physics = N
ctrl = 0
velset = 0, 0

[State 45, ChangeAnim]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, ChangeAnim]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = ifelse(Vel X = 0, 41, ifelse(Vel X > 0, 42, 43))

[State 45, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, VarSet]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, VarSet]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, VelSet]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1) = 0, const(velocity.airjump.neu.x), ifelse(sysvar(1) = 1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, ChangeState]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

[Statedef 50]; Jump Up******************************************************
type    = A
physics = A

[State 50, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Vel X = 0, 41, ifelse(Vel X > 0, 42, 43))

[Statedef 51]; Jump Down****************************************************
type    = A
physics = A

[State 51, Null]
type = Null
trigger1 = 1

[Statedef 52]; Jump Land****************************************************
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, PlaySnd];;
type = PlaySnd
trigger1 = Time = 0
value = 52, 0

[State 52, NotHitBy];
type = NotHitBy
trigger1 = !ctrl && PrevStateNo = 5040
value = SCA
time = 1

[State 52, VelSet]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, CtrlSet];
type = CtrlSet
trigger1 = Time = 3
trigger2 = PrevStateNo = 5040
value = 1

[State 52, VelSet]
type = VelSet
trigger1 = abs(Vel X) < Const(movement.stand.friction.threshold)
x = 0

[State 52, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 57]; Special Land?***********************************************;
type    = A
physics = A

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
value = 41
elem =1
persistent = 0

[State 0, VelSet]
type = VelSet
trigger1 = time=0&&(prevstateno=841||prevstateno=3050)
x = -1
y = -8

[State 51, 1]
type = Null
trigger1 = 1

[Statedef 100]; Run**********************************************************
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, CtrlSet]
type = CtrlSet
trigger1 = AILevel
value = 0

[State 100, PlaySnd];;
type = PlaySnd
trigger1 = AnimElem = 3
trigger2 = AnimElem = 9
value = 100,0

[State 100, VelSet]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, NoWalk]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, NoAutoTurn]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, ChangeState]
type = ChangeState
triggerall = !AILevel
trigger1 = command != "holdfwd"
value = 0

[State 100, AIChangeState];
type = ChangeState
triggerall = AILevel
;
trigger1 = P2BodyDist X <= 80
;
trigger2 = EnemyNear,MoveType = A
trigger2 = P2BodyDist X <= 280
trigger2 = random <= AILevel/8*500 || AILevel > 6
;
trigger3 = EnemyNear,NumProj
;
trigger4 = RoundState != 2
value = 0
ctrl = 1

[Statedef 105]; Dash Back****************************************************;
type = A
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 105, VelSet]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)*ifelse((prevstateno=[200,440]),1.02,1)
y = const(velocity.run.back.y)

[State 105, VelAdd]
type = VelAdd
trigger1 = Time > 0
y = const(movement.yaccel)*.625

[State 105, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 105, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = s105,0
channel = 1

[State 105, NoWalk]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 105, NoAutoTurn]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 105, Explod]
type = Explod
trigger1 = AnimElemTime(5) = 0
anim = 909
id = 909
pos = 0,0
vel = 10,-5
postype = P1
sprpriority = 3
ownpal = 1
persistent = 1

[State 105, ChangeState]
type = ChangeState
triggerall = Time > 0
trigger1 = Pos Y > 2
value = 106

