[Statedef 175]; DRAWGAME (Time over)****************************************
type = S
ctrl = 0
velset = 0,0

[State 175, ChangeState] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 175, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, NotHitBy]
